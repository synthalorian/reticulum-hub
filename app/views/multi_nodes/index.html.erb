<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-white">Multi-Node Dashboard</h1>
  <span class="text-sm text-gray-400"><%= @nodes.size %> node<%= "s" if @nodes.size > 1 %></span>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
  <% @nodes.each do |node| %>
    <div class="bg-gray-800 rounded-xl border border-gray-700 p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-white"><%= node[:name] %></h3>
        <span class="text-xs text-gray-500 font-mono"><%= node[:host] %>:<%= node[:port] %></span>
      </div>
      <div class="space-y-2 text-sm">
        <div class="flex justify-between">
          <span class="text-gray-500">Socket</span>
          <span class="text-gray-300 font-mono"><%= node[:socket] %></span>
        </div>
      </div>
      <div class="mt-4">
        <%= link_to "View Details", multi_node_path(node[:id]), class: "text-sm px-3 py-1.5 bg-cyan-600 hover:bg-cyan-700 text-white rounded-lg transition" %>
      </div>
    </div>
  <% end %>
</div>

<div class="mt-8 bg-gray-800 rounded-xl border border-gray-700 p-6">
  <h2 class="text-lg font-semibold text-white mb-4">Add Nodes via Environment</h2>
  <p class="text-sm text-gray-400 mb-3">Set the <code class="bg-gray-700 px-1 rounded">RETICULUM_NODES</code> environment variable:</p>
  <pre class="text-xs text-gray-300 font-mono bg-gray-900 rounded-lg p-4 overflow-x-auto">RETICULUM_NODES="name=Home,host=192.168.1.10,port=3742;name=Field,host=10.0.0.5,port=3742"</pre>
</div>
