<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Reticulum Hub" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "synthwave", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= action_cable_meta_tag %>
  </head>

  <body class="bg-gray-900 text-gray-100 min-h-screen dark" data-controller="keyboard-shortcuts theme">
    <div class="flex h-screen" data-controller="mobile-sidebar">
      <%# Mobile hamburger %>
      <div class="lg:hidden fixed top-4 left-4 z-50">
        <button data-action="click->mobile-sidebar#toggle" class="p-2 bg-gray-800 border border-gray-700 rounded-lg text-white">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>

      <%# Overlay %>
      <div data-mobile-sidebar-target="overlay" data-action="click->mobile-sidebar#close" class="hidden fixed inset-0 bg-black/50 z-40 lg:hidden"></div>

      <%# Sidebar %>
      <aside data-mobile-sidebar-target="sidebar" class="fixed lg:static inset-y-0 left-0 w-64 bg-gray-800 border-r border-gray-700 flex flex-col transform -translate-x-full lg:translate-x-0 transition-transform duration-200 z-50">
        <div class="p-6 border-b border-gray-700 flex items-center justify-between">
          <div>
            <h1 class="text-xl font-bold text-cyan-400 tracking-wider">⊛ RETICULUM</h1>
            <p class="text-xs text-gray-500 mt-1">Hub v1.0.0</p>
          </div>
          <button data-action="click->mobile-sidebar#close" class="lg:hidden p-1 text-gray-400 hover:text-white">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
          <%= link_to dashboard_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium #{current_page?(dashboard_path) || current_page?(root_path) ? 'bg-gray-700 text-cyan-400' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
            Dashboard
          <% end %>

          <%= link_to messages_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium #{current_page?(messages_path) ? 'bg-gray-700 text-cyan-400' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
            Messages
            <% unread = Message.unread.count %>
            <% if unread > 0 %>
              <span class="ml-auto bg-cyan-500 text-gray-900 text-xs font-bold px-2 py-0.5 rounded-full"><%= unread %></span>
            <% end %>
          <% end %>

          <%= link_to interfaces_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium #{current_page?(interfaces_path) ? 'bg-gray-700 text-cyan-400' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            Interfaces
          <% end %>

          <%= link_to multi_nodes_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium #{current_page?(multi_nodes_path) ? 'bg-gray-700 text-cyan-400' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
            Multi-Node
          <% end %>

          <%= link_to health_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium #{current_page?(health_path) ? 'bg-gray-700 text-cyan-400' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
            Health
          <% end %>

          <%= link_to retention_index_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium #{current_page?(retention_index_path) ? 'bg-gray-700 text-cyan-400' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            Retention
          <% end %>

          <%= link_to api_tokens_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium #{current_page?(api_tokens_path) ? 'bg-gray-700 text-cyan-400' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
            API Tokens
          <% end %>

          <%= link_to backups_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium #{current_page?(backups_path) ? 'bg-gray-700 text-cyan-400' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5l-4-4m4 4l-4 4"/></svg>
            Backups
          <% end %>

          <%= link_to maps_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium #{current_page?(maps_path) ? 'bg-gray-700 text-cyan-400' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Map
          <% end %>

          <%= link_to metrics_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium #{current_page?(metrics_path) ? 'bg-gray-700 text-cyan-400' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            Metrics
          <% end %>

          <%= link_to explorer_index_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium #{current_page?(explorer_index_path) ? 'bg-gray-700 text-cyan-400' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
            Explorer
          <% end %>

          <%= link_to configs_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium #{current_page?(configs_path) ? 'bg-gray-700 text-cyan-400' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            Config
          <% end %>

          <%= link_to alerts_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium #{current_page?(alerts_path) ? 'bg-gray-700 text-cyan-400' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            Alerts
            <% active_alerts = Alert.active.count %>
            <% if active_alerts > 0 %>
              <span class="ml-auto bg-red-500 text-white text-xs font-bold px-2 py-0.5 rounded-full"><%= active_alerts %></span>
            <% end %>
          <% end %>

          <%= link_to logs_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium #{current_page?(logs_path) ? 'bg-gray-700 text-cyan-400' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            Logs
          <% end %>

          <button data-action="click->theme#toggle" data-theme-target="toggle" class="p-2 text-gray-400 hover:text-white transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          </button>

          <%= link_to settings_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium #{current_page?(settings_path) ? 'bg-gray-700 text-cyan-400' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Settings
          <% end %>
        </nav>

        <div class="p-4 border-t border-gray-700">
          <div class="flex items-center text-xs text-gray-500">
            <div class="w-2 h-2 rounded-full bg-green-500 mr-2" id="connection-status"></div>
            <span id="connection-text">Connected</span>
          </div>
        </div>
      </aside>

      <%# Main content %>
      <main class="flex-1 overflow-y-auto pt-16 lg:pt-0">
        <div class="p-8">
          <% if notice %>
            <div class="mb-4 p-4 bg-green-900/50 border border-green-700 rounded-lg text-green-300" data-controller="flash">
              <%= notice %>
            </div>
          <% end %>
          <% if alert %>
            <div class="mb-4 p-4 bg-red-900/50 border border-red-700 rounded-lg text-red-300" data-controller="flash">
              <%= alert %>
            </div>
          <% end %>

          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html>
