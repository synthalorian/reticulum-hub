<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Reticulum Hub" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= action_cable_meta_tag %>
  </head>

  <body class="bg-gray-900 text-gray-100 min-h-screen">
    <div class="flex h-screen">
      <%# Sidebar %>
      <aside class="w-64 bg-gray-800 border-r border-gray-700 flex flex-col">
        <div class="p-6 border-b border-gray-700">
          <h1 class="text-xl font-bold text-cyan-400 tracking-wider">⊛ RETICULUM</h1>
          <p class="text-xs text-gray-500 mt-1">Hub v1.0.0</p>
        </div>

        <nav class="flex-1 p-4 space-y-1">
          <%= link_to dashboard_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium #{current_page?(dashboard_path) || current_page?(root_path) ? 'bg-gray-700 text-cyan-400' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
            Dashboard
          <% end %>

          <%= link_to messages_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium #{current_page?(messages_path) ? 'bg-gray-700 text-cyan-400' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
            Messages
            <% unread = Message.unread.count %>
            <% if unread > 0 %>
              <span class="ml-auto bg-cyan-500 text-gray-900 text-xs font-bold px-2 py-0.5 rounded-full"><%= unread %></span>
            <% end %>
          <% end %>

          <%= link_to interfaces_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium #{current_page?(interfaces_path) ? 'bg-gray-700 text-cyan-400' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            Interfaces
          <% end %>

          <%= link_to explorer_index_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium #{current_page?(explorer_index_path) ? 'bg-gray-700 text-cyan-400' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
            Explorer
          <% end %>

          <%= link_to alerts_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium #{current_page?(alerts_path) ? 'bg-gray-700 text-cyan-400' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            Alerts
            <% active_alerts = Alert.active.count %>
            <% if active_alerts > 0 %>
              <span class="ml-auto bg-red-500 text-white text-xs font-bold px-2 py-0.5 rounded-full"><%= active_alerts %></span>
            <% end %>
          <% end %>
        </nav>

        <div class="p-4 border-t border-gray-700">
          <div class="flex items-center text-xs text-gray-500">
            <div class="w-2 h-2 rounded-full bg-green-500 mr-2" id="connection-status"></div>
            <span id="connection-text">Connected</span>
          </div>
        </div>
      </aside>

      <%# Main content %>
      <main class="flex-1 overflow-y-auto">
        <div class="p-8">
          <% if notice %>
            <div class="mb-4 p-4 bg-green-900/50 border border-green-700 rounded-lg text-green-300" data-controller="flash">
              <%= notice %>
            </div>
          <% end %>
          <% if alert %>
            <div class="mb-4 p-4 bg-red-900/50 border border-red-700 rounded-lg text-red-300" data-controller="flash">
              <%= alert %>
            </div>
          <% end %>

          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html>
