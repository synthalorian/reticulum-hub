<div class="mb-6">
  <h1 class="text-2xl font-bold text-white">System Settings</h1>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="bg-gray-800 rounded-xl border border-gray-700 p-6">
    <h2 class="text-lg font-semibold text-white mb-4">Reticulum Daemon</h2>
    <%= form_with url: settings_path, method: :patch, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :rnsd_host, "Host", class: "block text-sm font-medium text-gray-300 mb-1" %>
        <%= f.text_field :rnsd_host, value: @rnsd_host,
              class: "w-full bg-gray-700 border border-gray-600 rounded-lg px-3 py-2 text-white" %>
      </div>
      <div>
        <%= f.label :rnsd_port, "Port", class: "block text-sm font-medium text-gray-300 mb-1" %>
        <%= f.number_field :rnsd_port, value: @rnsd_port,
              class: "w-full bg-gray-700 border border-gray-600 rounded-lg px-3 py-2 text-white" %>
      </div>
      <div>
        <%= f.label :rnsd_socket, "Unix Socket", class: "block text-sm font-medium text-gray-300 mb-1" %>
        <%= f.text_field :rnsd_socket, value: @rnsd_socket,
              class: "w-full bg-gray-700 border border-gray-600 rounded-lg px-3 py-2 text-white" %>
      </div>
      <div>
        <%= f.label :poll_interval, "Poll Interval (seconds)", class: "block text-sm font-medium text-gray-300 mb-1" %>
        <%= f.number_field :poll_interval, value: @poll_interval,
              class: "w-full bg-gray-700 border border-gray-600 rounded-lg px-3 py-2 text-white" %>
      </div>
      <div class="pt-2">
        <%= f.submit "Save",
              class: "px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white text-sm font-medium rounded-lg transition" %>
      </div>
    <% end %>
  </div>

  <div class="bg-gray-800 rounded-xl border border-gray-700 p-6">
    <h2 class="text-lg font-semibold text-white mb-4">Alert Notifications</h2>
    <%= form_with url: settings_path, method: :patch, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :alert_webhook, "Webhook URL", class: "block text-sm font-medium text-gray-300 mb-1" %>
        <%= f.text_field :alert_webhook, value: @alert_webhook, placeholder: "https://hooks.example.com/...",
              class: "w-full bg-gray-700 border border-gray-600 rounded-lg px-3 py-2 text-white placeholder-gray-500" %>
      </div>
      <div>
        <%= f.label :alert_lxmf, "LXMF Destination", class: "block text-sm font-medium text-gray-300 mb-1" %>
        <%= f.text_field :alert_lxmf, value: @alert_lxmf, placeholder: "<destination_hash>",
              class: "w-full bg-gray-700 border border-gray-600 rounded-lg px-3 py-2 text-white placeholder-gray-500" %>
      </div>
      <div class="pt-2">
        <%= f.submit "Save",
              class: "px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white text-sm font-medium rounded-lg transition" %>
      </div>
    <% end %>
  </div>

  <div class="bg-gray-800 rounded-xl border border-gray-700 p-6">
    <h2 class="text-lg font-semibold text-white mb-4">About</h2>
    <div class="space-y-2 text-sm text-gray-400">
      <p><span class="text-gray-500">Version:</span> v1.0.0</p>
      <p><span class="text-gray-500">Rails:</span> <%= Rails.version %></p>
      <p><span class="text-gray-500">Ruby:</span> <%= RUBY_VERSION %></p>
      <p><span class="text-gray-500">Environment:</span> <%= Rails.env %></p>
    </div>
  </div>
</div>
