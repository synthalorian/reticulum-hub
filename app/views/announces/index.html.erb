<div class="mb-6">
  <h1 class="text-2xl font-bold text-white">Send Announcement</h1>
</div>

<div class="bg-gray-800 rounded-xl border border-gray-700 p-6 max-w-xl">
  <%= form_with url: announces_path, class: "space-y-6" do |f| %>
    <div>
      <%= f.label :name, "Service Name", class: "block text-sm font-medium text-gray-300 mb-2" %>
      <%= f.text_field :name,
            class: "w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white placeholder-gray-500 focus:ring-2 focus:ring-cyan-500 focus:border-transparent",
            placeholder: "My Service" %>
    </div>

    <div>
      <%= f.label :service_type, "Service Type", class: "block text-sm font-medium text-gray-300 mb-2" %>
      <%= f.select :service_type,
            options_for_select([["LXMF", "lxmf"], ["Nomad Network", "nomad"], ["Fileshare", "fileshare"], ["Custom", "custom"]]),
            {},
            class: "w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
    </div>

    <div>
      <%= f.label :port, "Port (optional)", class: "block text-sm font-medium text-gray-300 mb-2" %>
      <%= f.number_field :port,
            class: "w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white placeholder-gray-500 focus:ring-2 focus:ring-cyan-500 focus:border-transparent",
            placeholder: "8" %>
    </div>

    <div class="flex items-center justify-end space-x-3">
      <%= link_to "Cancel", explorer_index_path, class: "px-4 py-2 text-gray-400 hover:text-white text-sm font-medium" %>
      <%= f.submit "Announce",
            class: "px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white text-sm font-medium rounded-lg transition" %>
    </div>
  <% end %>
</div>
