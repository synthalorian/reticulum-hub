<div class="mb-6">
  <%= link_to explorer_index_path, class: "text-sm text-gray-400 hover:text-white flex items-center" do %>
    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    Back to explorer
  <% end %>
</div>

<div class="bg-gray-800 rounded-xl border border-gray-700 p-6 max-w-3xl">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-bold text-white"><%= @node.name || "Unknown Node" %></h1>
    <span class="text-xs text-gray-400 font-mono"><%= @node.formatted_hops %></span>
  </div>

  <div class="bg-gray-900 rounded-lg p-4 mb-6">
    <p class="text-xs text-gray-500 mb-1">Destination Hash</p>
    <p class="text-sm font-mono text-cyan-400"><%= @node.destination_hash %></p>
  </div>

  <% if @services.any? %>
    <h2 class="text-lg font-semibold text-white mb-3">Services</h2>
    <div class="space-y-2">
      <% @services.each do |svc| %>
        <div class="bg-gray-750 rounded-lg p-4 border border-gray-700">
          <div class="flex items-center justify-between">
            <div>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-cyan-900/50 text-cyan-400"><%= svc.service_type %></span>
              <% if svc.name %>
                <span class="ml-2 text-sm text-white"><%= svc.name %></span>
              <% end %>
            </div>
            <% if svc.port %>
              <span class="text-xs text-gray-500 font-mono">port <%= svc.port %></span>
            <% end %>
          </div>
          <% if svc.description %>
            <p class="text-sm text-gray-400 mt-2"><%= svc.description %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500">No services announced by this node.</p>
  <% end %>
</div>
