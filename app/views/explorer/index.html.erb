<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-white">Network Explorer</h1>
  <span class="text-sm text-gray-400"><%= @nodes.size %> nodes discovered</span>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2">
    <div class="bg-gray-800 rounded-xl border border-gray-700 p-6">
      <h2 class="text-lg font-semibold text-white mb-4">Topology</h2>
      <div id="topology-map" class="h-96 bg-gray-900 rounded-lg relative overflow-hidden"
           data-controller="topology-map"
           data-topology-map-nodes-value="<%= @network_map[:nodes].to_json %>"
           data-topology-map-edges-value="<%= @network_map[:edges].to_json %>">
        <canvas data-topology-map-target="canvas" class="absolute inset-0 w-full h-full"></canvas>
      </div>
      <div class="mt-3 flex items-center space-x-4 text-xs text-gray-500">
        <span class="flex items-center"><span class="w-2 h-2 rounded-full bg-cyan-400 mr-1"></span> Local</span>
        <span class="flex items-center"><span class="w-2 h-2 rounded-full bg-green-500 mr-1"></span> Active</span>
        <span class="flex items-center"><span class="w-2 h-2 rounded-full bg-yellow-500 mr-1"></span> Degraded</span>
        <span class="flex items-center"><span class="w-2 h-2 rounded-full bg-red-500 mr-1"></span> Offline</span>
      </div>
    </div>
  </div>

  <div>
    <div class="bg-gray-800 rounded-xl border border-gray-700">
      <div class="px-6 py-4 border-b border-gray-700">
        <h2 class="text-lg font-semibold text-white">Discovered Nodes</h2>
      </div>
      <div class="divide-y divide-gray-700">
        <% @nodes.each do |node| %>
          <%= link_to explorer_path(node.destination_hash), class: "block px-6 py-4 hover:bg-gray-750" do %>
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-sm font-medium text-white"><%= node.name || "Unknown" %></h3>
                <p class="text-xs text-gray-500 font-mono mt-0.5"><%= node.destination_hash %></p>
              </div>
              <div class="text-right">
                <span class="text-xs text-gray-400"><%= node.formatted_hops %></span>
                <% if node.services.any? %>
                  <div class="flex gap-1 mt-1 justify-end">
                    <% node.services.first(3).each do |svc| %>
                      <span class="text-[10px] px-1.5 py-0.5 bg-gray-700 text-gray-300 rounded"><%= svc.service_type %></span>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
