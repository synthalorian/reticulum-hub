<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-white">LXMF Messages</h1>
  <%= link_to new_message_path, class: "inline-flex items-center px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white text-sm font-medium rounded-lg transition" do %>
    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    Compose
  <% end %>
</div>

<% if @messages.any? %>
  <div class="bg-gray-800 rounded-xl border border-gray-700">
    <% @conversations.each do |key, messages| %>
      <% latest = messages.first %>
      <% peer = Peer.find_by(destination_hash: latest.sender_hash) || Peer.find_by(destination_hash: latest.recipient_hash) %>
      <%= link_to message_path(latest), class: "block px-6 py-4 border-b border-gray-700 hover:bg-gray-750 last:border-b-0" do %>
        <div class="flex items-start justify-between">
          <div class="flex-1 min-w-0">
            <div class="flex items-center mb-1">
              <h3 class="text-sm font-medium text-white truncate"><%= peer&.name || latest.sender_hash %></h3>
              <% unless latest.read %>
                <span class="ml-2 w-2 h-2 bg-cyan-500 rounded-full"></span>
              <% end %>
            </div>
            <p class="text-sm text-gray-400 truncate"><%= latest.subject || "(no subject)" %></p>
            <p class="text-xs text-gray-500 mt-1"><%= latest.truncated_body(length: 80) %></p>
          </div>
          <div class="ml-4 text-right">
            <p class="text-xs text-gray-500"><%= latest.sent_at&.strftime("%H:%M") || "—" %></p>
            <p class="text-xs text-gray-600 mt-1"><%= messages.size %> msg<%= "s" if messages.size > 1 %></p>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="bg-gray-800 rounded-xl border border-gray-700 p-12 text-center">
    <svg class="w-12 h-12 text-gray-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
    <p class="text-gray-400">No messages yet.</p>
    <p class="text-sm text-gray-500 mt-2">Start a conversation by composing a new message.</p>
  </div>
<% end %>
