<div class="p-6 max-w-5xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-white">Data Retention</h1>
      <p class="text-sm text-gray-400 mt-1">Manage database size with automatic cleanup policies</p>
    </div>
    <%= button_to "Run Cleanup Now", cleanup_retention_index_path, method: :post,
          class: "px-4 py-2 bg-red-900/30 text-red-400 border border-red-700 rounded-lg hover:bg-red-900/50 transition-colors",
          data: { turbo_confirm: "Delete old records according to retention policies?" } %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
    <% @stats.each do |table, count| %>
      <div class="bg-gray-800 border border-gray-700 rounded-lg p-4">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-sm font-medium text-gray-300"><%= table.to_s.titleize %></h3>
          <span class="text-xs px-2 py-0.5 bg-gray-700 rounded text-gray-400">
            <%= @policies[table]&.[](:days) || "—" %> days
          </span>
        </div>
        <p class="text-2xl font-bold text-white"><%= number_with_delimiter(count) %></p>
        <p class="text-xs text-gray-500 mt-1">records</p>
      </div>
    <% end %>
  </div>

  <div class="bg-gray-800 border border-gray-700 rounded-lg p-6">
    <h2 class="text-lg font-semibold text-white mb-4">Retention Policies</h2>
    <table class="w-full text-sm">
      <thead class="bg-gray-900">
        <tr>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-400 uppercase">Table</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-400 uppercase">Retention</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-400 uppercase">Description</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-700">
        <% @policies.each do |table, policy| %>
          <tr class="hover:bg-gray-700/50">
            <td class="px-4 py-3 text-gray-300 font-mono text-xs"><%= table %></td>
            <td class="px-4 py-3 text-cyan-400"><%= policy[:days] %> days</td>
            <td class="px-4 py-3 text-gray-400 text-xs">Auto-delete records older than <%= policy[:days] %> days</td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <p class="text-xs text-gray-500 mt-4">Configure a cron job or systemd timer to run <code class="bg-gray-900 px-1 rounded">DataRetentionService.cleanup!</code> daily.</p>
  </div>
</div>
