<div class="p-6 max-w-7xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-white">Network Performance</h1>
      <p class="text-sm text-gray-400 mt-1">RTT, throughput, and path quality over time</p>
    </div>
    <div class="flex items-center gap-2">
      <%= form_with url: metrics_path, method: :get, class: "flex items-center gap-2" do |f| %>
        <%= f.select :hours,
              options_for_select([["Last 1 hour", 1], ["Last 6 hours", 6], ["Last 24 hours", 24], ["Last 7 days", 168]], @hours),
              {}, class: "bg-gray-800 border border-gray-700 text-gray-300 text-sm rounded-lg px-3 py-1.5" %>
        <%= f.submit "Update", class: "px-3 py-1.5 text-sm bg-cyan-900/30 text-cyan-400 border border-cyan-700 rounded-lg hover:bg-cyan-900/50" %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <%# RTT Chart %>
    <div class="bg-gray-800 border border-gray-700 rounded-lg p-4">
      <h2 class="text-lg font-semibold text-white mb-3">Round-Trip Time (ms)</h2>
      <div data-controller="chart" data-chart-type-value="line" data-chart-data-value="<%= @rtt_data.to_json %>" data-chart-color-value="#00F0FF" class="h-64"></div>
    </div>

    <%# Throughput Chart %>
    <div class="bg-gray-800 border border-gray-700 rounded-lg p-4">
      <h2 class="text-lg font-semibold text-white mb-3">Throughput (KB/s)</h2>
      <div data-controller="chart" data-chart-type-value="area" data-chart-data-value="<%= @throughput_data.to_json %>" data-chart-color-value="#8F00FF" class="h-64"></div>
    </div>

    <%# Path Quality %>
    <div class="bg-gray-800 border border-gray-700 rounded-lg p-4">
      <h2 class="text-lg font-semibold text-white mb-3">Path Quality (%)</h2>
      <div data-controller="chart" data-chart-type-value="line" data-chart-data-value="<%= @path_quality_data.to_json %>" data-chart-color-value="#F3E70F" class="h-64"></div>
    </div>

    <%# Packet Loss %>
    <div class="bg-gray-800 border border-gray-700 rounded-lg p-4">
      <h2 class="text-lg font-semibold text-white mb-3">Packet Loss (%)</h2>
      <div data-controller="chart" data-chart-type-value="bar" data-chart-data-value="<%= @packet_loss_data.to_json %>" data-chart-color-value="#FF7EDB" class="h-64"></div>
    </div>
  </div>
</div>
